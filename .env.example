# Copy to .env for docker compose. Use your own values; .env is not committed.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
JWT_SECRET_KEY=
AUDIT_SIGNING_KEY=
BACKUP_ENCRYPTION_KEY=

# Creates the first platform admin on an empty production database, then can be removed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional government tile service, e.g. https://maps.example.gov.in/{z}/{x}/{y}.png
GIS_CUSTOM_BASEMAP_URL=

# ADM-T04 white-labelling and domains
# Encrypts uploaded certificate private keys. Certificate uploads are refused until this is set.
CERT_ENCRYPTION_KEY=
# Comma-separated domains tenants may never claim, such as the platform's own.
PLATFORM_RESERVED_DOMAINS=
# Hostname tenants point CNAME records at.
PLATFORM_CNAME_TARGET=
# Let's Encrypt account email. The certificate manager stays idle until it is set.
ACME_EMAIL=

# ADM-S04 quotas and usage
# Signs SMS delivery reports. Reports are refused until this is set.
SMS_WEBHOOK_SECRET=
# Alert email. The Email channel cannot be selected until a host is set.
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
